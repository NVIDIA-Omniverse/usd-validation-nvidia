#usda 1.0
(
    endTimeCode = 70
    framesPerSecond = 24
    startTimeCode = 70
    timeCodesPerSecond = 24
)

over "fake" (
    prepend references = @./doesNotExist.usda@</fake>
)
{
}

def Xform "Root"(
    kind = "group"
)
{
    def Sphere "Sphere"(
        kind = "component"
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </Root/Looks/Surface>
        def Sphere "NestedSphere"(
            kind = "component"
        )
        {
        }
    }

    def Sphere "BadSphere"(
        kind = "fake"
    )
    {
    }

    def Xform "MissingKind"
    {
        def Sphere "LeafSphere"(
            kind = "component"
        )
        {
        }
    }

    def "Looks"
    {
        def Material "Surface"
        {
            token outputs:surface.connect = </Root/Looks/Surface/PreviewSurface.outputs:surface>

            def Shader "DiffuseColorTex"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (0, 0, 0, 0) (
                    connectability = "interfaceOnly"
                )
                float4 inputs:fallback = (0, 0, 0, 1)
                asset inputs:file = @./curves.usda@ (
                    connectability = "interfaceOnly"
                )
                float4 inputs:scale = (1, 1, 1, 1) (
                    connectability = "interfaceOnly"
                )
                token inputs:sourceColorSpace = "auto" (
                    allowedTokens = ["raw", "sRGB", "auto"]
                    connectability = "interfaceOnly"
                )
                float2 inputs:st = (0, 0)
                token inputs:wrapS = "useMetadata" (
                    allowedTokens = ["black", "clamp", "repeat", "mirror", "useMetadata"]
                    connectability = "interfaceOnly"
                )
                token inputs:wrapT = "useMetadata" (
                    allowedTokens = ["black", "clamp", "repeat", "mirror", "useMetadata"]
                    connectability = "interfaceOnly"
                )
                float outputs:a
                float outputs:b
                float outputs:g
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0
                float inputs:clearcoatRoughness = 0.01
                color3f inputs:diffuseColor = (0.18, 0.18, 0.18)
                color3f inputs:diffuseColor.connect = </Root/Looks/Surface/DiffuseColorTex.outputs:rgb>
                float inputs:displacement = 0
                color3f inputs:emissiveColor = (0, 0, 0)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                normal3f inputs:normal = (0, 0, 1)
                float inputs:occlusion = 1
                float inputs:opacity = 1
                float inputs:opacityThreshold = 0 (
                    connectability = "interfaceOnly"
                )
                float inputs:roughness = 0.5
                color3f inputs:specularColor = (0, 0, 0)
                int inputs:useSpecularWorkflow = 0 (
                    connectability = "interfaceOnly"
                )
                token outputs:displacement (
                    renderType = "material"
                )
                token outputs:surface (
                    renderType = "material"
                )
            }
        }
    }
}

def Xform "NotAModel"
{
    def Xform "StillNotAModel"(
        kind = "assembly"
    )
    {
        def Sphere "BaseKind"(
            kind = "model"
        )
        {
        }
    }

    def Xform "Subcomponent"(
        kind = "subcomponent"
    )
    {
        def Xform "AlsoNotAModel"(
            kind = "group"
        )
        {
        }

        def Sphere "BadComponent"
        (
            kind = "component"
        )
        {
        }
    }
}
