#usda 1.0
(
    endFrame = 10
    startFrame = 1
    upAxis = "Y"
    metersPerUnit = 1
    defaultPrim = "World"
    subLayers = [
        @./Materials/incorrectMaterialSublayer.usda@,
    ]
)

def Xform "World"(
    variants = {
        string Material = "Correct"
    }
    prepend variantSets = ["Material"]
)
{
    variantSet "Material" = {
        "Correct" {
            def "Looks"(
                references = @./Materials/knownMaterial.usda@
            )
            {
            }
        }
        "MissingDot" {
            def "Looks"(
                references = @./Materials/missingDotMaterial.usda@
            )
            {
            }
        }
    }
}
