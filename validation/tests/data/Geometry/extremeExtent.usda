#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Sphere"
    {
        float3[] extent = [(-1, -1, -1), (1, 1, 1)]
        double size = 2.0
        double3 xformOp:translate = (0.0, 0.0, 0.0)
        double3 xformOp:scale = (1.0, 1.0, 1.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Xform "TranslateX"
    {
        over "Pass" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:translate = (274877906943.0, 0.0, 0.0)
        }
        over "Fail" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:translate = (274877906944.0, 0.0, 0.0)
        }
    }

    def Xform "TranslateY"
    {
        over "Pass" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:translate = (0.0, 274877906943.0, 0.0)
        }
        over "Fail" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:translate = (0.0, 274877906944.0, 0.0)
        }
    }

    def Xform "TranslateZ"
    {
        over "Pass" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:translate = (0.0, 0.0, 274877906943.0)
        }
        over "Fail" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:translate = (0.0, 0.0, 274877906944.0)
        }
    }

    def Xform "ScaleX"
    {
        over "Pass" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:scale = (274877906943.0, 1.0, 1.0)
        }
        over "Fail" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:scale = (274877906945.0, 1.0, 1.0)

        }
    }

    def Xform "ScaleY"
    {
        over "Pass" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:scale = (1.0, 274877906943.0, 1.0)
        }
        over "Fail" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:scale = (1.0, 274877906945.0, 1.0)
        }
    }

    def Xform "ScaleZ"
    {
        over "Pass" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:scale = (1.0, 1.0, 274877906943.0)
        }
        over "Fail" ( prepend references = </World/Sphere> )
        {
            double3 xformOp:scale = (1.0, 1.0, 274877906945.0)
        }
    }
}
