# Normalize text files on commit to LF endings by default
* text=auto
# Windows batch files require CR/LF for labels
*.bat text eol=crlf
*.cmd text eol=crlf
# Shell scripts must have LF endings even on Windows
*.sh text eol=lf
# Test data and spec assets go into Git LFS
tests/data/** filter=lfs diff=lfs merge=lfs -text
specs/_static/** filter=lfs diff=lfs merge=lfs -text
**/*.png filter=lfs diff=lfs merge=lfs -text
**/*.jpg filter=lfs diff=lfs merge=lfs -text
**/*.gif filter=lfs diff=lfs merge=lfs -text
**/*.mp4 filter=lfs diff=lfs merge=lfs -text
**/*.usdz filter=lfs diff=lfs merge=lfs -text
**/*.zip filter=lfs diff=lfs merge=lfs -text
# USD/MDL text formats — keep as-is (no filter, no line-ending conversion)
**/*.usda !text !filter !merge !diff
**/*.usd !text !filter !merge !diff
**/*.mdl !text !filter !merge !diff
**/*.usdc !text !filter !merge !diff
