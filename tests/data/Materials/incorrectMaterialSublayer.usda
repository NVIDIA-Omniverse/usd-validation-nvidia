#usda 1.0
(
    defaultPrim = "Looks"
    upAxis = "Y"
)

def Xform "World"(
    variants = {
        string MaterialSublayer = "Incorrect"
    }
    prepend variantSets = ["Material"]
)
{
    variantSet "Material" = {
        "Incorrect" {
            def "Looks"
            {
                def Material "MatX"
                {
                    token outputs:mdl:displacement.connect = </Looks/MatX/Shader.outputs:out>
                    token outputs:mdl:surface.connect = </Looks/MatX/Shader.outputs:out>
                    token outputs:mdl:volume.connect = </Looks/MatX/Shader.outputs:out>

                    def Shader "Shader"
                    {
                        uniform token info:implementationSource = "sourceAsset"
                        uniform asset info:mdl:sourceAsset = @material.mdl@
                        uniform token info:mdl:sourceAsset:subIdentifier = "MatX"
                        token outputs:out
                    }
                }
            }
        }
    }
}
